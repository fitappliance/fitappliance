{
  "schemaVersion": 1,
  "policyVersion": "2026-08-05.1",
  "documentTypePriority": [
    "installation_guide",
    "quick_reference_guide",
    "specification_sheet",
    "user_manual",
    "product_page",
    "family_manual"
  ],
  "transport": {
    "curlPreferredHosts": ["resource.electrolux.com.au", "www.westinghouse.com.au"],
    "curlHttp1OnlyHosts": ["www.westinghouse.com.au"],
    "scraplingFallbackHosts": ["au.asko.com", "static13.asko.com", "www.beko.com"],
    "preserveCurlDefaultUserAgentHosts": ["resource.electrolux.com.au", "www.westinghouse.com.au"],
    "timeoutMsByHost": {
      "partners.gorenje.com": 90000
    },
    "requestHeadersByHost": {
      "content.fisherpaykel.com": {
        "referer": "https://www.fisherpaykel.com/"
      }
    }
  },
  "brands": {
    "electrolux": {
      "templates": [
        { "documentType": "specification_sheet", "url": "https://resource.electrolux.com.au/Factsheet/RequestPdf?modelNumber={model}&brand=Electrolux" }
      ]
    },
    "westinghouse": {
      "templates": [
        { "documentType": "specification_sheet", "url": "https://resource.electrolux.com.au/Factsheet/RequestPdf?modelNumber={model}&brand=Westinghouse" }
      ]
    },
    "kelvinator": {
      "templates": [
        { "documentType": "specification_sheet", "url": "https://resource.electrolux.com.au/Factsheet/RequestPdf?modelNumber={model}&brand=Kelvinator" }
      ]
    },
    "bosch": {
      "templates": [
        { "documentType": "specification_sheet", "url": "https://media3.bosch-home.com/Documents/specsheet/en-AU/{model}.pdf" }
      ]
    },
    "fisherpaykel": { "templates": [] },
    "haier": { "templates": [] },
    "hisense": { "templates": [] },
    "lg": { "templates": [] },
    "samsung": { "templates": [] },
    "smeg": {
      "templates": [
        { "documentType": "specification_sheet", "url": "https://sys.smeg.com.au/Product/Techspecs/{model}.pdf" }
      ]
    },
    "miele": { "templates": [] }
  }
}
